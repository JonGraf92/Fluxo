{
  "name": "fluxo",
  "version": "1.0.0",
  "private": true,
  "description": "Fluxo — controle financeiro pessoal, local-first, privado por padrão.",
  "author": "Fluxo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": "11.16.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "dist-electron/electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron dist-electron/electron/main/index.js",
    "build:vite": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && esbuild electron/preload/index.ts --bundle --platform=node --target=node20 --external:electron --format=cjs --outfile=dist-electron/electron/preload/index.js",
    "build": "npm run build:vite && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./run-vitest-electron.mjs",
    "test:node": "vitest run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./run-vitest-electron.mjs --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "kysely": "^0.27.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "44.4.5",
    "electron-builder": "26.17.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
